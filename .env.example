# CryptHunter — dev/QA credentials and config.
#
# Copy this file to .env (gitignored) ONCE and fill in the values you need:
#   cp .env.example .env
#
# script/agent/setup.sh and script/agent/qa-sandbox.sh auto-source .env, so you
# set your keys a single time on this machine and are never prompted again.
# Only the providers you actually QA against are required.

# ── AI Provider API Keys ──────────────────────────────────────────────────────
# Uncomment and fill in only the providers you use.
# A commented key keeps any value already in your shell or Codespaces secrets.
# An empty uncommented value would override it with an empty string — don't do that.

# Anthropic (Claude) — recommended for heavy pentest and CTF reasoning
# ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, o3, o1) — recommended for web CTF and code RE
# OPENAI_API_KEY=

# Google (Gemini) — good for large context (long binary analysis, big codebases)
# GEMINI_API_KEY=

# xAI (Grok) — alternative for red team / offensive reasoning
# XAI_API_KEY=

# Groq (fast inference, llama/mixtral) — fast CTF iteration
# GROQ_API_KEY=

# Together AI (open models) — cheap parallelism for team mode
# TOGETHER_API_KEY=

# DeepSeek (DeepSeek-R1, V3) — strong math / crypto reasoning
# DEEPSEEK_API_KEY=

# Fireworks AI (fast open model inference)
# FIREWORKS_API_KEY=

# AWS Bedrock (Claude on AWS) — enterprise red team engagements
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# Ollama (local models — zero cost, air-gapped CTF environments)
# OLLAMA_HOST=http://localhost:11434

# LM Studio (local models)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── OpenCode Server ───────────────────────────────────────────────────────────
# Password for `opencode serve` based QA (see the opencode-qa skill).
# OPENCODE_SERVER_PASSWORD=

# ── CryptHunter Behavior Flags ────────────────────────────────────────────────
# Force `bun run build` even when dist/index.js already exists.
# CRYPTHUNTER_FORCE_BUILD=1

# Default engagement mode when no --mode flag is given.
# One of: auto | ctf | bug-bounty | red-team | blue-team | offensive | grey-hat | forensic | reverse-engineering | mobile-pentest
# CRYPTHUNTER_DEFAULT_MODE=auto

# Disable PostHog telemetry (set to 1 to opt out).
# CRYPTHUNTER_DISABLE_TELEMETRY=0

# Override default web dashboard port (default: 7474).
# CRYPTHUNTER_DASHBOARD_PORT=7474

# Skip tool auto-install prompt (set to 1 to always auto-install without asking).
# CRYPTHUNTER_AUTO_INSTALL_TOOLS=0

# ── CTF Mode Flags ────────────────────────────────────────────────────────────
# Default parallelism for CTF mode (default: 8).
# CRYPTHUNTER_CTF_PARALLELISM=8

# Max iterations for CTF pentest-loop (default: 200).
# CRYPTHUNTER_CTF_MAX_ITERATIONS=200

# CTF flag format regex override (default: FLAG{.*} and common variants).
# CRYPTHUNTER_CTF_FLAG_REGEX=FLAG\{[^}]+\}

# Auto-submit flags to CTFd instance (requires CTFD_TOKEN).
# CRYPTHUNTER_CTF_AUTO_SUBMIT=0
# CRYPTHUNTER_CTFD_URL=
# CRYPTHUNTER_CTFD_TOKEN=

# ── Phantom C2 ────────────────────────────────────────────────────────────────
# Teamserver connection (red team engagements).
# PHANTOM_SERVER_HOST=
# PHANTOM_SERVER_PORT=31337
# PHANTOM_OPERATOR_CONFIG=~/.phantom/operator.cfg

# ── OpenClaw (External Notifications) ────────────────────────────────────────
# Discord webhook for engagement notifications.
# OPENCLAW_DISCORD_WEBHOOK=

# Telegram bot for engagement notifications.
# OPENCLAW_TELEGRAM_BOT_TOKEN=
# OPENCLAW_TELEGRAM_CHAT_ID=

# HTTP webhook for engagement events.
# OPENCLAW_WEBHOOK_URL=

# ── Shodan / OSINT APIs ───────────────────────────────────────────────────────
# Used by recon skills (shodan-recon, recon-full, etc.)
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# SECURITYTRAILS_API_KEY=
# HUNTER_API_KEY=
# VIRUSTOTAL_API_KEY=
# URLSCAN_API_KEY=

# ── Bug Bounty Platforms ──────────────────────────────────────────────────────
# Used by report skills to auto-submit findings.
# HACKERONE_API_TOKEN=
# HACKERONE_USERNAME=
# BUGCROWD_API_TOKEN=

# ── Internal QA Only (do not set in production) ───────────────────────────────
# Legacy flag for setup.sh compatibility — prefer CRYPTHUNTER_FORCE_BUILD above.
# OMO_AGENT_FORCE_BUILD=1
